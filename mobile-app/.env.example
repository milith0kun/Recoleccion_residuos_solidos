# URL del backend Next.js
# LOCAL en emulador Android:  http://10.0.2.2:3000
# LOCAL en emulador iOS:      http://localhost:3000
# LOCAL en dispositivo físico: http://TU-IP-LAN:3000 (ej. http://192.168.1.42:3000)
# PRODUCCIÓN:                  https://srss.ecosdelseo.com
EXPO_PUBLIC_API_URL=https://srss.ecosdelseo.com

# Google OAuth — Client IDs creados en https://console.cloud.google.com/apis/credentials
# El WEB es obligatorio (también funciona en Expo Go para móvil vía proxy).
# Android e iOS son opcionales (solo si harás dev build / EAS build).
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
