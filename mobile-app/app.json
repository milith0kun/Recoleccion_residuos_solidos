{
  "expo": {
    "name": "SRSS Cusco",
    "slug": "srss-cusco",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "srss",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a2e88712-6ddf-4dba-8047-38630a18d3d9",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pe.gob.cusco.srss",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte las rutas de recolección cercanas",
        "NSLocationAlwaysUsageDescription": "Necesitamos tu ubicación para el tracking GPS de la ruta"
      }
    },
    "android": {
      "package": "pe.gob.cusco.srss",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "SRSS Cusco necesita acceder a tu ubicación para el seguimiento de rutas."
        }
      ],
      "expo-font",
      "expo-updates",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.378647499793-placeholder"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a2e88712-6ddf-4dba-8047-38630a18d3d9"
      }
    },
    "owner": "milith0kun"
  }
}
